+void TWPartitionManager::RefreshFixedRemovableDevices() {
+  twrp_operation_executor::guard transaction(twrp_operation_executor::instance().mutex());
+  for (TWPartition* part : partitions_) {
+    // Sysfs/wildcard entries are handled by HandleUevent/ResyncUeventDevices.
+    if (!part->removable_ || part->is_sub_partition_ || !part->sysfs_entry_.empty() ||
+        part->wildcard_block_device_ || part->is_adopted_storage_)
+      continue;
+    const bool was_present = part->is_present_;
+    const std::string was_device = part->actual_block_device_;
+    part->FindActualBlockDevice();
+    const bool changed = was_present != part->is_present_ || was_device != part->actual_block_device_;
+    if (was_present && changed) {
+      LOGINFO("%s changed or was removed (%s)\n", part->mount_point_.c_str(), was_device.c_str());
+      part->Unmount(false);
+      part->size_ = part->used_ = part->free_ = 0;
+    }
+    // Also retry while present but never mounted: the node can show up before
+    // the card has finished probing.
+    if (part->is_present_ && (changed || (!part->IsMounted() && part->size_ == 0))) {
+      LOGINFO("%s appeared on %s\n", part->mount_point_.c_str(), part->actual_block_device_.c_str());
+      part->UpdateSize(false, false, true);
+    }
+  }
+}
+
