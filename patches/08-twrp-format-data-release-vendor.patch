+// Format Data has to unmap every dynamic partition (CheckPendingMerges), but devices that set
+// ro.twrp.keep_vendor_mounted keep /vendor busy: the TEE and Wi-Fi daemons run from it. Ask init
+// (init.recovery.*.rc, on property:twrp.prep_format=1) to stop them and release /vendor first.
+static void ReleaseVendorForFormat() {
+  if (!android::base::GetBoolProperty("ro.twrp.keep_vendor_mounted", false)) return;
+
+  LOGINFO("Releasing /vendor before Format Data.\n");
+  android::base::SetProperty("twrp.prep_format.done", "0");
+  // Go through 0 so the trigger fires again on a second Format Data in the same boot.
+  android::base::SetProperty("twrp.prep_format", "0");
+  if (!android::base::SetProperty("twrp.prep_format", "1")) {
+    LOGERR("Unable to set twrp.prep_format.\n");
+    return;
+  }
+  for (int i = 0; i < 100 && !android::base::GetBoolProperty("twrp.prep_format.done", false); i++)
+    usleep(100000);
+  if (!android::base::GetBoolProperty("twrp.prep_format.done", false))
+    LOGERR("Timed out waiting for init to release /vendor.\n");
+}
