import /init.tee.rc

on early-init
    # Keep /vendor mounted: mcDriverDaemon, KeyMint and Gatekeeper run from there
    # long after TWRP's fstab pass (needs patches/02-twrp-keep-vendor-mounted.patch).
    setprop ro.twrp.keep_vendor_mounted 1

on init
    restorecon /kmsg
    restorecon_recursive /sys/devices/platform/soc/soc:mtk-leds
    restorecon_recursive /sys/devices/platform/soc/soc:regulator-vibrator/leds/vibrator
    restorecon /sys/devices/platform/soc/mt_usb/saving
    # Generated mount fstab lives on writable recovery tmpfs.
    symlink /tmp/fstab /etc/fstab
    # Wi-Fi sockets directory for TWRP GUI2 backend
    mkdir /tmp/recovery 0770 root root
    mkdir /tmp/recovery/sockets 0770 root root
    # dmsetup (Format Data) cannot mknod in recovery; point its control node at the real one.
    mkdir /dev/mapper 0755 root root
    symlink /dev/device-mapper /dev/mapper/control
    insmod /lib/modules/touch/adaptive-ts.ko
    insmod /lib/modules/touch/focaltech_ft3683g.ko
    insmod /lib/modules/touch/chipsemi_chsc5xxx_old.ko
    insmod /lib/modules/touch/tui-common.ko
    insmod /lib/modules/touch/gt9896s.ko
    insmod /lib/modules/touch/gt9886.ko
    # Subsystem dasar
    insmod /lib/modules/wifi/rfkill.ko
    insmod /lib/modules/wifi/cfg80211.ko
    # MTK Connectivity Bus & Throttling
    insmod /lib/modules/wifi/btif_drv.ko
    insmod /lib/modules/wifi/mtk_low_battery_throttling.ko
    insmod /lib/modules/wifi/connadp.ko
    insmod /lib/modules/wifi/connfem.ko
    # MTK WMT & WLAN Core
    insmod /lib/modules/wifi/wmt_drv.ko
    insmod /lib/modules/wifi/wmt_chrdev_wifi.ko
    insmod /lib/modules/wifi/wlan_drv_gen4m_6789.ko
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64
	setprop sys.usb.configfs 1
	setprop sys.usb.controller "musb-hdrc"
	setprop crypto.ready 1

	start vendor.boot-default
	
on fs
    wait /dev/block/platform/soc/11270000.ufshci
    symlink /dev/block/platform/soc/11270000.ufshci /dev/block/bootdevice
	install_keyring
    # Secure storage for mcDriverDaemon must be on the real persist, not tmpfs
    # (init.tee.rc post-fs creates mcRegistry/tee_logs below it).
    wait /dev/block/by-name/persist 5
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/persist 0771 system system
    # Persist TIDAK di-mount di sini: TWRP ('Unmounting main partitions') melepasnya
    # beberapa ratus ms kemudian. Mount dilakukan di on property:fstab.additional=1.

on property:fstab.additional=1
    # TWRP mounted /vendor (and /odm) from super and set fstab.additional.
    # ueventd created /dev/mobicore* before /vendor/etc/ueventd.rc was readable,
    # so restore ownership here. Only init builtins: an exec_start in this
    # action makes init silently drop the commands after it (start mobicore).
    chown system system /dev/mobicore
    chown system system /dev/mobicore-user
    chmod 0660 /dev/mobicore
    chmod 0660 /dev/mobicore-user
    # Persist asli untuk registry mcDriverDaemon. Harus setelah TWRP selesai unmount
    # main partitions. Opsi sama dengan fstab (flag fs_mgr wait/check/formattable tidak
    # berlaku; fsck tidak jalan).
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist nosuid nodev noatime noauto_da_alloc,commit=1,nodelalloc
    start mobicore

on property:ro.vendor.trustonic.ready=true
    start vendor.gatekeeper-default
    start vendor.keymint-trustonic

on property:servicemanager.ready=true
    setprop sys.boot_completed 1

# Gatekeeper
service vendor.gatekeeper-default /vendor/bin/hw/android.hardware.gatekeeper-service.trustonic
	class early_hal
	disabled
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user system
    group system
    seclabel u:r:hal_gatekeeper_default:s0

# Keymint
service vendor.keymint-trustonic /vendor/bin/hw/android.hardware.security.keymint@3.0-service.trustonic --rkp_version=v1
    class early_hal
    disabled
	interface android.hardware.keymaster@4.0::IKeymasterDevice default
    interface android.hardware.keymaster@4.1::IKeymasterDevice default
    user system
	group system
    seclabel u:r:hal_keymint_default:s0

# MTK AIDL Boot HAL
service vendor.boot-default /system/bin/hw/android.hardware.boot-service.mtk
    class early_hal
    user root
    group root
    interface aidl android.hardware.boot.IBootControl/default
    seclabel u:r:hal_bootctl_default:s0

# Override Health HAL service definition.
service vendor.health-default /system/bin/hw/android.hardware.health-service.example_recovery
    class hal
    user root
    group root
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    seclabel u:r:hal_health_default:s0
    override

# Override keystore2 service definition.	
service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
	interface aidl android.system.keystore2.IKeystoreService/default
    user root
    group root keystore readproc log
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:keystore:s0
	override

# Wi-Fi Supplicant for TWRP GUI2
service wpa_supplicant /system/bin/wpa_supplicant \
    -Dnl80211 -iwlan0 -dd -O/tmp/recovery/sockets \
    -c/system/etc/wifi/wpa_supplicant.conf
    disabled
    user root
    group root wifi
    seclabel u:r:recovery:s0

